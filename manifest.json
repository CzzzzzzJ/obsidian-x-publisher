{
  "manifest_version": 3,
  "name": "麦当发布助手",
  "version": "0.2.0",
  "description": "视频一键填写到 B站/小红书/抖音/视频号/YouTube/X，Obsidian 笔记插入 X 长文。只填写，不发布。",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://member.bilibili.com/*",
    "https://creator.xiaohongshu.com/*",
    "https://creator.douyin.com/*",
    "https://channels.weixin.qq.com/*",
    "https://studio.youtube.com/*",
    "https://www.youtube.com/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "麦当发布助手"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
