{
  "manifest_version": 3,
  "name": "麦田发布助手",
  "version": "0.3.1",
  "description": "麦田工作台的发布引擎：把一期视频的标题、正文、封面和定时一次填进你常用的视频平台上传页，也能把 Obsidian 笔记写进 X 长文。只填写，发布由你自己点。",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "tabs",
    "debugger",
    "notifications"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://member.bilibili.com/*",
    "https://creator.xiaohongshu.com/*",
    "https://creator.douyin.com/*",
    "https://channels.weixin.qq.com/*",
    "https://studio.youtube.com/*",
    "https://www.youtube.com/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "麦田发布助手"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
